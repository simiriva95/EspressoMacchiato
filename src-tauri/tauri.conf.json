{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EspressoMacchiato",
  "version": "0.1.0",
  "identifier": "app.espressomacchiato",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "EspressoMacchiato",
        "width": 420,
        "height": 680,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "radius": 14
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
