{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EspressoMacchiato",
  "version": "0.3.0",
  "identifier": "app.espressomacchiato",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "EspressoMacchiato",
        "width": 920,
        "height": 640,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "radius": 14
        },
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/99-espressomacchiato-uinput.rules": "../packaging/linux/99-espressomacchiato-uinput.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/99-espressomacchiato-uinput.rules": "../packaging/linux/99-espressomacchiato-uinput.rules"
        }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "espresso"
        ]
      }
    }
  }
}